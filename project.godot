; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="杨庄传奇"
config/icon="res://assets/icons/icon_1024.png"
run/main_scene="res://scenes/splash.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.0862745, 0.0627451, 0.172549, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/brand/splash.png"
boot_splash/fullsize=true

[autoload]

Settings="*res://src/core/settings.gd"
GameState="*res://src/core/game_state.gd"
Events="*res://src/core/events.gd"
Audio="*res://src/core/audio.gd"
Save="*res://src/core/save.gd"
AssetLibrary="*res://src/core/asset_library.gd"
MapThemes="*res://src/core/map_theme_library.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/custom_font="res://assets/fonts/NotoSansSC-Regular.otf"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true

